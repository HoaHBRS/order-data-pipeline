							{
								"activity": "log_data_quality",
								"dependencyConditions": [
									"Failed",
									"Skipped"
								]
							}
						],
						"policy": {
							"timeout": "0.12:00:00",
							"retry": 0,
							"retryIntervalInSeconds": 30,
							"secureOutput": false,
							"secureInput": false
						},
						"userProperties": [],
						"typeProperties": {
							"storedProcedureName": "[[dbo].[usp_log_pipeline_run]",
							"storedProcedureParameters": {
								"error_message": {
									"value": {
										"value": "@if(\n    equals(activity('copy_raw_orders_to_staging').Status, 'Failed'),\n    activity('copy_raw_orders_to_staging').error.message,\n    if(\n        equals(activity('upsert_valid_orders').Status, 'Failed'),\n        activity('upsert_valid_orders').error.message,\n        if(\n            equals(activity('insert_rejected_orders').Status, 'Failed'),\n            activity('insert_rejected_orders').error.message,\n            activity('log_data_quality').error.message\n        )\n    )\n)",
										"type": "Expression"
									},
									"type": "String"
								},
								"pipeline_name": {
									"value": {
										"value": "@pipeline().Pipeline",
										"type": "Expression"
									},
									"type": "String"
								},
								"pipeline_run_id": {
									"value": {
										"value": "@pipeline().RunId",
										"type": "Expression"
									},
									"type": "String"
								},
								"rows_copied": {
									"value": null,
									"type": "Int64"
								},
								"rows_read": {
									"value": null,
									"type": "Int64"
								},
								"run_status": {
									"value": "FAILED",
									"type": "String"
								},
								"source_file_pattern": {
									"value": {
										"value": "@pipeline().parameters.source_file_pattern",
										"type": "Expression"
									},
									"type": "String"
								}
							}
						},
						"linkedServiceName": {
							"referenceName": "ls_azure_sql_database_dev",
							"type": "LinkedServiceReference"
						}
					},
					{
						"name": "raise_pipeline_failure",
						"type": "Fail",
						"dependsOn": [
							{
								"activity": "log_pipeline_failure",
								"dependencyConditions": [
									"Succeeded"
								]
							}
						],
						"userProperties": [],
						"typeProperties": {
							"message": "Pipeline failed. See dbo.pipeline_runs for the original error.",
							"errorCode": "PIPELINE_FAILED"
						}
					},
					{
						"name": "log_data_quality",
						"type": "SqlServerStoredProcedure",
						"dependsOn": [
							{
								"activity": "insert_rejected_orders",
								"dependencyConditions": [
									"Succeeded"
								]
							}
						],
						"policy": {
							"timeout": "0.12:00:00",
							"retry": 0,
							"retryIntervalInSeconds": 30,
							"secureOutput": false,
							"secureInput": false
						},
						"userProperties": [],
						"typeProperties": {
							"storedProcedureName": "[[dbo].[usp_log_data_quality_run]",
							"storedProcedureParameters": {
								"pipeline_run_id": {
									"value": {
										"value": "@pipeline().RunId",
										"type": "Expression"
									},
									"type": "String"
								},
								"source_file_pattern": {
									"value": {
										"value": "@pipeline().parameters.source_file_pattern",
										"type": "Expression"
									},
									"type": "String"
								}
							}
						},
						"linkedServiceName": {
							"referenceName": "ls_azure_sql_database_dev",
							"type": "LinkedServiceReference"
						}
					}
				],
				"policy": {
					"elapsedTimeMetric": {}
				},
				"parameters": {
					"source_file_pattern": {
						"type": "string",
						"defaultValue": "orders_*.csv"
					}
				},
				"annotations": [],
				"lastPublishTime": "2026-09-11T05:47:03Z"
			},
			"dependsOn": [
