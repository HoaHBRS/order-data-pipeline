				"schema": [
					{
						"name": "order_id",
						"type": "nvarchar"
					},
					{
						"name": "customer_id",
						"type": "nvarchar"
					},
					{
						"name": "status",
						"type": "nvarchar"
					},
					{
						"name": "amount_cents",
						"type": "nvarchar"
					},
					{
						"name": "updated_at",
						"type": "nvarchar"
					},
					{
						"name": "source_file",
						"type": "nvarchar"
					},
					{
						"name": "loaded_at",
						"type": "datetime2",
						"scale": 7
					}
				],
				"typeProperties": {
					"schema": "dbo",
					"table": "staging_orders"
				}
			},
			"dependsOn": [
