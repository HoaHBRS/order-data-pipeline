										"sink": {
											"name": "order_id"
										}
									},
									{
										"source": {
											"name": "customer_id",
											"type": "String",
											"physicalType": "String"
										},
										"sink": {
											"name": "customer_id"
										}
									},
									{
										"source": {
											"name": "status",
											"type": "String",
											"physicalType": "String"
										},
										"sink": {
											"name": "status"
										}
									},
									{
										"source": {
											"name": "amount_cents",
											"type": "String",
											"physicalType": "String"
										},
										"sink": {
											"name": "amount_cents"
										}
									},
									{
										"source": {
											"name": "updated_at",
											"type": "String",
											"physicalType": "String"
										},
										"sink": {
											"name": "updated_at"
										}
									},
									{
										"source": {
											"name": "source_file",
											"type": "String"
										},
										"sink": {
											"name": "source_file"
										}
									}
								],
								"typeConversion": true,
								"typeConversionSettings": {
									"allowDataTruncation": true,
									"treatBooleanAsNumber": false
