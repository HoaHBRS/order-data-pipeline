						"linkedServiceName": {
							"referenceName": "ls_azure_sql_database_dev",
							"type": "LinkedServiceReference"
						}
					},
					{
						"name": "insert_rejected_orders",
						"type": "SqlServerStoredProcedure",
						"dependsOn": [
							{
								"activity": "upsert_valid_orders",
								"dependencyConditions": [
									"Succeeded"
								]
							}
						],
						"policy": {
							"timeout": "0.00:10:00",
							"retry": 1,
							"retryIntervalInSeconds": 30,
							"secureOutput": false,
							"secureInput": false
						},
						"userProperties": [],
						"typeProperties": {
							"storedProcedureName": "[[dbo].[usp_insert_rejected_orders]"
						},
						"linkedServiceName": {
							"referenceName": "ls_azure_sql_database_dev",
							"type": "LinkedServiceReference"
						}
					},
					{
						"name": "log_pipeline_success",
						"type": "SqlServerStoredProcedure",
						"dependsOn": [
							{
								"activity": "log_data_quality",
								"dependencyConditions": [
									"Succeeded"
								]
							}
						],
						"policy": {
							"timeout": "0.12:00:00",
							"retry": 0,
							"retryIntervalInSeconds": 30,
							"secureOutput": false,
							"secureInput": false
						},
						"userProperties": [],
						"typeProperties": {
							"storedProcedureName": "[[dbo].[usp_log_pipeline_run]",
							"storedProcedureParameters": {
								"error_message": {
									"value": null,
									"type": "String"
								},
								"pipeline_name": {
									"value": {
										"value": "@pipeline().Pipeline",
										"type": "Expression"
									},
									"type": "String"
								},
								"pipeline_run_id": {
									"value": {
										"value": "@pipeline().RunId",
										"type": "Expression"
									},
									"type": "String"
								},
								"rows_copied": {
									"value": {
										"value": "@activity('copy_raw_orders_to_staging').output.rowsCopied",
										"type": "Expression"
